{
  "name": "@nestjs-automapper/core",
  "version": "2.0.0-alpha.0",
  "description": "Schema-aware object mapping for TypeScript \u2014 zero dependencies",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "node ../../scripts/tsc6.mjs -p tsconfig.json --noEmit",
    "typecheck:ts7": "node ../../scripts/typecheck-ts7.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
