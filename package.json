{
  "name": "@nestjs-automapper/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for @nestjs-automapper 2.0 — the mapper that knows your schema",
  "license": "MIT",
  "author": "Nishit Shivdasani",
  "repository": {
    "type": "git",
    "url": "https://github.com/BottomsNode/custom-automapper.git"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nx run-many -t typecheck",
    "typecheck:ts7": "nx run-many -t typecheck:ts7",
    "lint": "nx run-many -t lint",
    "verify": "pnpm typecheck && pnpm typecheck:ts7 && pnpm test && pnpm build && pnpm check:zero-deps",
    "check:zero-deps": "node scripts/check-zero-deps.mjs"
  },
  "devDependencies": {
    "@nx/js": "23.2.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "5.0.0",
    "nx": "23.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.0.0"
  }
}
